#!/usr/bin/env bash
# herdr-workspace — arma un workspace ("space") de herdr con un grid de panes
# (3x2 si hay 6 workspaces, o una fila si hay otra cantidad), uno por cada
# entrada de un archivo de lista de workspaces, y lanza Claude Code
# INTERACTIVO en cada uno.
#
# Antes de lanzar claude en cada pane, valida (con salida visible y log):
#   1) git fetch --prune
#   2) si hay cambios sin commitear, se DESCARTAN (git reset --hard + clean -fd).
#      Regla del workspace: todo debe estar commiteado; nada de valor debe
#      quedar sin commit en estos clones.
#   3) checkout a $HERDR_WORKSPACE_BRANCH si no estaba ya ahí (crea la rama
#      local desde origin/<rama> si no existe)
#   4) git pull --ff-only   (si no es fast-forward, NO se lanza claude)
# Si cualquier paso falla, NO se lanza claude: se imprime la razón exacta,
# queda el log completo, y (en WSL, si hay powershell.exe) se manda
# notificación nativa de Windows.
#
# Ver también: herdr-workspace-safe, la variante que nunca descarta cambios.
#
# Configuración (variables de entorno, todas opcionales):
#   HERDR_WORKSPACE_CONF   lista de workspaces "etiqueta|ruta" por línea
#                          (default: ~/.config/herdr-workspaces/list.conf;
#                          ver list.conf.example en este repo)
#   HERDR_WORKSPACE_LABEL  nombre del space en herdr (default: "claude workspaces")
#   HERDR_WORKSPACE_BRANCH rama requerida en cada clone (default: "main")
#   HERDR_WORKSPACE_LAUNCH_DIR  dir para launchers/logs (default: ~/.cache/herdr-workspaces)
#   PS_EXE                 ruta a powershell.exe para notificar en WSL
#                          (default: /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe)
# ============================================================================
set -uo pipefail
CONF="${HERDR_WORKSPACE_CONF:-$HOME/.config/herdr-workspaces/list.conf}"
LAUNCH_DIR="${HERDR_WORKSPACE_LAUNCH_DIR:-$HOME/.cache/herdr-workspaces}"
LOG_DIR="$LAUNCH_DIR/logs/$(date +%Y%m%d-%H%M%S)-herdr"
WS_LABEL="${HERDR_WORKSPACE_LABEL:-claude workspaces}"
REQUIRED_BRANCH="${HERDR_WORKSPACE_BRANCH:-main}"
PS_EXE="${PS_EXE:-/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe}"

command -v herdr  >/dev/null || { echo "falta herdr en PATH"; exit 1; }
command -v jq     >/dev/null || { echo "falta jq"; exit 1; }
command -v claude >/dev/null || { echo "falta claude en PATH"; exit 1; }
[ -f "$CONF" ] || { echo "falta la lista de workspaces: $CONF (ver scripts/list.conf.example)"; exit 1; }
herdr status >/dev/null 2>&1 || { echo "no hay servidor herdr corriendo (abre herdr primero)"; exit 1; }
mkdir -p "$LAUNCH_DIR" "$LOG_DIR"

labels=(); dirs=()
while IFS='|' read -r lb dr; do
  lb="${lb## }"; lb="${lb%% }"
  [[ -z "$lb" || "$lb" == \#* ]] && continue
  dr="${dr## }"; dr="${dr%% }"; dr="${dr/#\~/$HOME}"
  if [ ! -d "$dr/.git" ]; then
    echo "  · omito '$lb' (no existe $dr)"; continue
  fi
  labels+=("$lb"); dirs+=("$dr")
done < "$CONF"

n=${#labels[@]}
[ "$n" -eq 0 ] && { echo "Ningún workspace existe. Revisa $CONF"; exit 1; }

# si ya existe un space con esta etiqueta de una corrida anterior, se cierra
old_id="$(herdr workspace list 2>/dev/null | jq -r --arg lb "$WS_LABEL" '.result.workspaces[] | select(.label==$lb) | .workspace_id' | head -n1)"
if [ -n "$old_id" ]; then
  echo "cerrando space previo '$WS_LABEL' ($old_id)…"
  herdr workspace close "$old_id" >/dev/null 2>&1 || true
fi

make_launcher() {
  local lb="$1" dir="$2" log="$3"
  local launcher="$LAUNCH_DIR/hw_${lb}.sh"
  cat > "$launcher" <<EOF
#!/usr/bin/env bash
LOG="$log"
LB="$lb"
DIR="$dir"
PS_EXE="$PS_EXE"
REQUIRED_BRANCH="$REQUIRED_BRANCH"

cd "\$DIR" || { echo "✗ [\$LB] claude NO se lanzó por: no se pudo entrar a \$DIR"; exit 1; }
: > "\$LOG"

log()  { printf '%s\n' "\$1" | tee -a "\$LOG"; }
run()  { log "+ \$*"; "\$@" >>"\$LOG" 2>&1; return \$?; }

notify() {
  [ -x "\$PS_EXE" ] || return 0
  "\$PS_EXE" -NoProfile -NonInteractive -Command "
    Add-Type -AssemblyName System.Windows.Forms;
    \\\$n = New-Object System.Windows.Forms.NotifyIcon;
    \\\$n.Icon = [System.Drawing.SystemIcons]::Warning;
    \\\$n.Visible = \\\$true;
    \\\$n.ShowBalloonTip(6000,'herdr-workspace: \$LB','Claude no se lanzó. Revisa el pane.','Warning');
    Start-Sleep -Milliseconds 800
  " >/dev/null 2>&1 &
}

fail() {
  log ""
  log "✗ [\$LB] claude NO se lanzó por: \$1"
  log "   log completo: \$LOG"
  notify
  exit 1
}

log "── \$LB (\$DIR) ──"

run git fetch --prune origin || fail "git fetch --prune origin falló (revisa red/credenciales; ver log)"

if [ -n "\$(git status --porcelain)" ]; then
  log "⚠ había cambios sin commitear en \$DIR: se descartan (siempre debe estar commiteado antes de correr herdr-workspace)"
  run git reset --hard HEAD || fail "git reset --hard falló (ver log)"
  run git clean -fd || fail "git clean -fd falló (ver log)"
fi

branch="\$(git rev-parse --abbrev-ref HEAD)"
log "rama actual: \$branch"
if [ "\$branch" != "\$REQUIRED_BRANCH" ]; then
  if git show-ref --verify --quiet "refs/heads/\$REQUIRED_BRANCH"; then
    run git checkout "\$REQUIRED_BRANCH" || fail "git checkout \$REQUIRED_BRANCH falló (ver log)"
  else
    run git checkout -B "\$REQUIRED_BRANCH" "origin/\$REQUIRED_BRANCH" || fail "no existe rama local '\$REQUIRED_BRANCH' y no se pudo crear desde origin/\$REQUIRED_BRANCH (ver log)"
  fi
  log "cambiado a rama: \$REQUIRED_BRANCH"
fi

run git pull --ff-only origin "\$REQUIRED_BRANCH" || fail "git pull --ff-only falló (rama divergente o conflicto; ver log)"

log "✓ rama \$REQUIRED_BRANCH actualizada, lanzando claude…"
claude
echo
echo "[\$LB] claude salió. Pane normal en: \$DIR"
EOF
  chmod +x "$launcher"
  echo "$launcher"
}

ratio_for() { awk "BEGIN{printf \"%.4f\", 1/$1}"; }

# split_row <pane_padre> <cant_columnas> <indice_inicial_en_dirs> -> imprime pane_ids (uno por línea)
split_row() {
  local parent="$1" count="$2" start="$3"
  echo "$parent"
  local cur="$parent" i remaining ratio resp newpane idx
  for ((i = 1; i < count; i++)); do
    remaining=$((count - i + 1))
    ratio="$(ratio_for "$remaining")"
    idx=$((start + i))
    resp="$(herdr pane split "$cur" --direction right --ratio "$ratio" --cwd "${dirs[$idx]}" --no-focus)" \
      || { echo "✗ no se pudo dividir el pane para '${labels[$idx]}'" >&2; exit 1; }
    newpane="$(jq -r '.result.pane.pane_id' <<<"$resp")"
    echo "$newpane"
    cur="$newpane"
  done
}

echo "creando space '$WS_LABEL' con ${n} pane(s)…"
ws_json="$(herdr workspace create --cwd "${dirs[0]}" --label "$WS_LABEL" --no-focus)" \
  || { echo "✗ herdr workspace create falló"; exit 1; }
wsid="$(jq -r '.result.workspace.workspace_id' <<<"$ws_json")"
p0="$(jq -r '.result.root_pane.pane_id' <<<"$ws_json")"

panes=()
if [ "$n" -eq 6 ]; then
  # grid 3x2, igual al layout "tiled" de tmux para 6 paneles
  resp="$(herdr pane split "$p0" --direction down --ratio 0.5 --cwd "${dirs[3]}" --no-focus)"
  bottom="$(jq -r '.result.pane.pane_id' <<<"$resp")"
  mapfile -t row1 < <(split_row "$p0" 3 0)
  mapfile -t row2 < <(split_row "$bottom" 3 3)
  panes=("${row1[@]}" "${row2[@]}")
else
  # fallback: una sola fila de $n columnas
  mapfile -t panes < <(split_row "$p0" "$n" 0)
fi

for i in "${!labels[@]}"; do
  lb="${labels[$i]}"; dir="${dirs[$i]}"; pane="${panes[$i]}"
  log="$LOG_DIR/${lb}.log"
  launcher="$(make_launcher "$lb" "$dir" "$log")"
  herdr pane rename "$pane" "$lb" >/dev/null 2>&1 || true
  sleep 0.2
  herdr pane run "$pane" "bash $launcher" >/dev/null || echo "  ⚠ no se pudo lanzar en '$lb' ($pane)"
  echo "  $lb → $dir (pane $pane)"
done

herdr workspace focus "$wsid" >/dev/null 2>&1 || true
echo "▶ space '$WS_LABEL' listo con ${#panes[@]} pane(s). Logs en: $LOG_DIR"
