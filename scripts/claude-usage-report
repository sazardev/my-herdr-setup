#!/usr/bin/env python3
"""claude-usage-report — resumen de consumo de tokens de Claude Code por
proyecto (slot) y modelo, leyendo los transcripts JSONL que Claude Code ya
escribe en ~/.claude/projects/**/*.jsonl.

Cero telemetría nueva, cero infra: los datos ya existen en disco. Útil para
ver, entre los slots de gm-erp2-agentic-N (u otro proyecto), quién está
gastando tokens y si el cache de prompt se está reusando (cache_read alto,
bueno) o recreando todo el tiempo (cache_creation alto en relación al total,
señal de "fuga" — cada sesión nueva repaga el prefijo completo del system
prompt + tools + skills).

Uso:
  claude-usage-report                       # todos los proyectos, todo el histórico
  claude-usage-report --since today         # solo hoy
  claude-usage-report --since 2026-09-20    # desde esa fecha (incl.)
  claude-usage-report --project agentic     # filtra por substring del path del proyecto
  claude-usage-report --by-day              # desglosa por día además de por proyecto/modelo
"""
import argparse
import json
import sys
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path

PROJECTS_DIR = Path.home() / ".claude" / "projects"


def parse_since(value):
    if value is None:
        return None
    if value == "today":
        now = datetime.now(timezone.utc)
        return datetime(now.year, now.month, now.day, tzinfo=timezone.utc)
    return datetime.fromisoformat(value).replace(tzinfo=timezone.utc)


def short_project(dirname):
    # "-home-omar-dev-gm-erp2-agentic-4" -> "gm-erp2-agentic-4"
    home_prefix = "-" + str(Path.home()).strip("/").replace("/", "-") + "-"
    if dirname.startswith(home_prefix):
        return dirname[len(home_prefix):]
    return dirname.lstrip("-")


def iter_usage_records(since, project_filter):
    if not PROJECTS_DIR.is_dir():
        return
    for project_dir in sorted(PROJECTS_DIR.iterdir()):
        if not project_dir.is_dir():
            continue
        label = short_project(project_dir.name)
        if project_filter and project_filter not in label:
            continue
        for jsonl in project_dir.glob("*.jsonl"):
            try:
                with jsonl.open(encoding="utf-8") as fh:
                    for line in fh:
                        line = line.strip()
                        if not line:
                            continue
                        try:
                            obj = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        if obj.get("type") != "assistant":
                            continue
                        message = obj.get("message") or {}
                        usage = message.get("usage")
                        if not usage:
                            continue
                        ts_raw = obj.get("timestamp")
                        try:
                            ts = datetime.fromisoformat(ts_raw.replace("Z", "+00:00")) if ts_raw else None
                        except ValueError:
                            ts = None
                        if since and ts and ts < since:
                            continue
                        yield {
                            "project": label,
                            "model": message.get("model") or "?",
                            "date": ts.date().isoformat() if ts else "?",
                            "input": usage.get("input_tokens") or 0,
                            "output": usage.get("output_tokens") or 0,
                            "cache_read": usage.get("cache_read_input_tokens") or 0,
                            "cache_creation": usage.get("cache_creation_input_tokens") or 0,
                        }
            except OSError:
                continue


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--since", help="'today', o fecha ISO (2026-09-20)")
    ap.add_argument("--project", help="filtra por substring del nombre del proyecto/slot")
    ap.add_argument("--by-day", action="store_true", help="desglosa también por día")
    args = ap.parse_args()

    since = parse_since(args.since)
    key_fields = ("project", "model") + (("date",) if args.by_day else ())
    totals = defaultdict(lambda: defaultdict(int))
    requests = defaultdict(int)

    for rec in iter_usage_records(since, args.project):
        key = tuple(rec[f] for f in key_fields)
        for field in ("input", "output", "cache_read", "cache_creation"):
            totals[key][field] += rec[field]
        requests[key] += 1

    if not totals:
        print("sin datos (revisa --since / --project, o que existan transcripts en", PROJECTS_DIR, ")", file=sys.stderr)
        return

    rows = []
    for key, t in totals.items():
        total_input_side = t["input"] + t["cache_read"] + t["cache_creation"]
        cache_creation_pct = (t["cache_creation"] / total_input_side * 100) if total_input_side else 0.0
        rows.append((*key, requests[key], t["input"], t["output"], t["cache_read"], t["cache_creation"], cache_creation_pct))

    rows.sort(key=lambda r: -(r[len(key_fields) + 2] + r[len(key_fields) + 4]))  # por cache_read+cache_creation desc

    headers = list(key_fields) + ["reqs", "input", "output", "cache_read", "cache_creation", "%cache_creation"]
    widths = [max(len(h), *(len(str(r[i])) for r in rows)) for i, h in enumerate(headers)]
    fmt = "  ".join("{:<%d}" % w for w in widths[:-1]) + "  {:>%d}" % widths[-1]

    print(fmt.format(*headers))
    print(fmt.format(*["-" * w for w in widths]))
    for r in rows:
        r = list(r)
        r[-1] = f"{r[-1]:.0f}%"
        print(fmt.format(*r))

    grand = defaultdict(int)
    grand_reqs = 0
    for key, t in totals.items():
        grand_reqs += requests[key]
        for f in ("input", "output", "cache_read", "cache_creation"):
            grand[f] += t[f]
    print()
    print(f"total: {grand_reqs} requests · input={grand['input']} output={grand['output']} "
          f"cache_read={grand['cache_read']} cache_creation={grand['cache_creation']}")
    print("nota: sin $ — para costo exacto por request usa el exporter OTel console de Claude Code "
          "(CLAUDE_CODE_ENABLE_TELEMETRY=1 OTEL_METRICS_EXPORTER=console OTEL_LOGS_EXPORTER=console, "
          "solo en invocaciones headless `claude -p`, nunca en sesión interactiva: el exporter console "
          "rompe la TUI) o la consola de uso de Anthropic.")


if __name__ == "__main__":
    main()
